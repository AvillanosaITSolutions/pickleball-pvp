# --- Server ---
PORT=4000
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wallofanger
DATABASE_SSL=false

# --- Auth0 ---
# From your Auth0 API settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.wallofanger.app
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# --- PayMongo ---
# Get from https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxx
# Where PayMongo should redirect after checkout
PAYMONGO_SUCCESS_URL=http://localhost:5173/?payment=success
PAYMONGO_CANCEL_URL=http://localhost:5173/?payment=cancelled
